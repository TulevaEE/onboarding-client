{
  "name": "onboarding-client",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22.17.0"
  },
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@sentry/browser": "^11.8.0",
    "@tanstack/react-query": "^4.44.0",
    "@web-eid/web-eid-library": "2.1.0",
    "array.prototype.find": "^2.2.3",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "classnames": "^2.5.1",
    "connected-react-router": "^6.9.3",
    "downloadjs": "^1.4.7",
    "font-awesome": "^4.7.0",
    "history": "^4.10.1",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "npm-run-all": "^4.1.5",
    "promise": "^8.3.0",
    "prop-types": "^15.8.1",
    "qrcode.react": "^4.2.0",
    "qs": "^6.16.1",
    "react": "^17.0.2",
    "react-app-polyfill": "^3.0.0",
    "react-bootstrap": "^2.10.10",
    "react-chartjs-2": "5.3.0",
    "react-dom": "^17.0.2",
    "react-ga4": "^2.1.0",
    "react-global-configuration": "1.4.1",
    "react-gtm-module": "^2.0.11",
    "react-hook-form": "^7.90.0",
    "react-intl": "^5.25.1",
    "react-redux": "^7.2.9",
    "react-router-dom": "^5.3.4",
    "react-tooltip": "4.2.17",
    "redux": "^4.2.1",
    "redux-form": "^8.3.10",
    "redux-thunk": "^2.4.2",
    "sass": "1.101.3",
    "tom-select": "^2.6.2",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "build": "react-scripts --openssl-legacy-provider build",
    "build:staging": "REACT_APP_ENV=staging react-scripts build",
    "develop": "react-scripts --openssl-legacy-provider start",
    "develop-production": "PROXY_TARGET=https://onboarding-service.tuleva.ee HTTPS=true HOST=local.tuleva.ee DANGEROUSLY_DISABLE_HOST_CHECK=true npm run develop",
    "develop-production-win": "set PROXY_TARGET=https://onboarding-service.tuleva.ee&&set HTTPS=true&&set HOST=local.tuleva.ee&&npm run develop",
    "lint": "eslint --ext .js,.ts,.jsx,.tsx src/ --max-warnings=0",
    "test": "TZ=UTC react-scripts test --coverage --json --outputFile=test-results.json --reporters=default --reporters=tdd-guard-jest",
    "lint:e2e": "eslint --ext .ts,.js e2e --max-warnings=0",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:android": "e2e/android/run.sh",
    "test:e2e:ios": "e2e/ios/run.sh",
    "update-snapshot": "react-scripts test --updateSnapshot",
    "eject": "react-scripts eject",
    "format": "eslint --ext .js,.ts,.jsx,.tsx src/ --fix --max-warnings=0",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tanstack/react-query-devtools": "^4.44.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^13.5.0",
    "@transferwise/eslint-config": "6.1.0",
    "@types/classnames": "^2.3.0",
    "@types/downloadjs": "^1.4.6",
    "@types/enzyme": "^3.10.19",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/qs": "^6.15.1",
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "@types/react-global-configuration": "^1.3.3",
    "@types/react-redux": "^7.1.35",
    "@types/react-router-dom": "^5.3.3",
    "@types/redux-form": "^8.3.11",
    "@types/redux-mock-store": "^1.5.0",
    "@wojtekmaj/enzyme-adapter-react-17": "^0.8.0",
    "axios-mock-adapter": "^2.1.0",
    "buffer": "^6.0.3",
    "enzyme": "^3.11.0",
    "enzyme-to-json": "^3.6.2",
    "eslint-plugin-formatjs": "^4.13.3",
    "eslint-plugin-fp": "^2.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^2.5.1",
    "eslint-plugin-testing-library": "^5.11.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "lint-staged": "^16.4.0",
    "msw": "^1.3.5",
    "prettier": "^2.8.8",
    "react-scripts": "^5.0.1",
    "react-test-renderer": "^17.0.2",
    "redux-mock-store": "^1.5.5",
    "tdd-guard-jest": "^0.1.4",
    "ts-jest": "^29.4.15"
  },
  "jest": {
    "coverageReporters": [
      "lcov",
      "text"
    ],
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(@web-eid|axios)).+\\.js$"
    ]
  },
  "lint-staged": {
    "src/**/*.{json,css,scss,md}": [
      "prettier --write"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged --debug"
    }
  },
  "browserslist": [
    ">0.3% in EE",
    "last 2 versions and last 2 years and supports es6-module",
    "not dead"
  ],
  "overrides": {
    "eslint": "^8.57.1",
    "@transferwise/eslint-config": {
      "eslint-plugin-prettier": "$eslint-plugin-prettier"
    },
    "cheerio": "1.0.0-rc.12",
    "@types/node": "^22.19.0",
    "react-global-configuration": {
      "serialize-javascript": "^7.0.7"
    },
    "react-tooltip": {
      "uuid": "^11.1.1"
    }
  }
}
